{
    "name": "phpthinky/browseropen",
    "description": "Browser open plugin for NativePHP Mobile - Open URLs in the device's default browser",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "phpthinky",
            "email": "info@democodes.online"
        }
    ],
    "autoload": {
        "psr-4": {
            "Phpthinky\\BrowserOpen\\": "src/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phpthinky\\BrowserOpen\\BrowserOpenServiceProvider"
            ]
        },
        "nativephp": {
            "platform": ["android", "ios"],
            "namespace": "BrowserOpen",
            "manifest": "nativephp.json"
        }
    }
}
