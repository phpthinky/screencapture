{
    "namespace": "BrowserOpen",
    "bridge_functions": [
        {
            "name": "BrowserOpen.Open",
            "android": "com.phpthinky.browseropen.BrowserOpenFunctions.Open",
            "ios": "BrowserOpenFunctions.Open",
            "description": "Open a URL in the device's default browser"
        }
    ],
    "android": {
        "min_version": 26,
        "permissions": [
            "android.permission.INTERNET"
        ],
        "queries": [
            "android.intent.action.VIEW",
            "android.intent.category.BROWSABLE"
        ]
    },
    "ios": {
        "min_version": "18.2",
        "info_plist": {}
    },
    "events": []
}
